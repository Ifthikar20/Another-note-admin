# Development settings, shared by scripts/dev.py and docker-compose.dev.yml.
# These are NOT secrets and must never be used anywhere but a developer's own machine:
# production refuses to start with ADMIN_DEV_IDENTITY, and needs 32+ character secrets
# made with `openssl rand -hex 32`, kept in SSM (see docs/DEPLOY.md).
ENVIRONMENT=development
ADMIN_API_URL=http://127.0.0.1:8001
ADMIN_SERVICE_TOKEN=dev-only-service-token-not-a-secret-0000000000
ADMIN_SIGNING_KEY=dev-only-signing-key-not-a-secret-11111111111
ADMIN_DEV_IDENTITY=dev@localhost:owner
